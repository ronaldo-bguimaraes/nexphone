{
  local_certs
}

:8443 {
  tls internal

  encode zstd gzip

  @websocket {
    path /ws/*
  }

  reverse_proxy @websocket gateway:8080

  reverse_proxy gateway:8080

  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    -Server
  }
}
